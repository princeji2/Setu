# Copy to .env.local (gateway/dashboard) and .env (each mock service).
# Never commit the filled-in version — this file only holds placeholder names.

# --- Dashboard / Gateway (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URLs for each mock service, so the gateway knows where to call.
# Point these at localhost during local dev, at deployed URLs on demo day.
LAND_RECORDS_SERVICE_URL=
CERTIFICATE_ISSUANCE_SERVICE_URL=
GRIEVANCE_SERVICE_URL=

# Credentials the gateway attaches per downstream call (see
# .kiro/steering/tech.md §4 — auth federation)
LAND_RECORDS_API_KEY=
CERTIFICATE_ISSUANCE_JWT_SECRET=

# --- Land Records service ---
LAND_RECORDS_API_KEY=          # must match the value above

# --- Certificate Issuance service ---
CERTIFICATE_ISSUANCE_JWT_SECRET=  # must match the value above

# --- Grievance service ---
# Session-cookie auth — no shared secret needed for the stub.

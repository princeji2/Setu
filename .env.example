# ============================================================
# Setu Gateway — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the filled-in .env.
#
# This is the GATEWAY's own config. Each department service in
# Mock_Sites/ has its own separate .env — do not merge them.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000                     # gateway's own port; keep distinct from the
                              # three department services (they use their own)

# --- Gateway database (PostgreSQL, gateway-owned tables only) ---
# See .kiro/steering/database-schema.md. Shares no storage with any department.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=setu_gateway_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL=false

# --- Citizen auth (hand-rolled, gateway-scoped) ---
# JWT the gateway issues to citizens on register/login. Not a department
# credential. Use a long random secret (min 32 chars).
JWT_SECRET=your_very_long_random_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- Officials/admin console (Phase A, read-only) ---
# Single shared secret gating the /api/v1/admin/* cross-citizen read
# endpoints, sent as the X-Admin-Key header. This is NOT a citizen JWT and
# NOT a department gateway key — it's a separate, isolated credential for
# the officials dashboard. Prototype-grade (see product.md). Use a long
# random value.
ADMIN_KEY=your_long_random_admin_console_key_here

# --- CORS — comma-separated allowed origins (the frontend app) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Department integration (Layer 2) — used in a LATER step.
# Base URL + gateway key per department. Keys are INDEPENDENT
# per department (one variable each) — never a single shared key,
# even if they happen to coincide in value in the demo setup.
# See api.md Part 2 and Mock_Sites/HOW_GATEWAY_CONNECTS_TO_MOCK_SITES.md.
# ============================================================

# Digital Tax Records (FastAPI + SQLite)
DTR_SERVICE_URL=http://localhost:8000
DTR_GATEWAY_KEY=your_digital_tax_records_gateway_key_here

# National Identity Registry (Node/Express + PostgreSQL) — runs on port 5000
NIR_SERVICE_URL=http://localhost:5000
NIR_GATEWAY_KEY=your_national_identity_registry_gateway_key_here

# Driving Licence & Jan Aadhaar Portal (Node/Express + PostgreSQL)
DLJA_SERVICE_URL=http://localhost:3001
DLJA_GATEWAY_KEY=your_driving_licence_jan_aadhaar_gateway_key_here

# Timeout (ms) applied to every outbound department call.
DEPARTMENT_CALL_TIMEOUT_MS=5000

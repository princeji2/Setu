# ============================================================
# Driving Licence & Jan Aadhaar Registration Portal
# Environment Variables — Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_documents_portal_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL=false

# JWT Authentication
JWT_SECRET=your_very_long_random_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=8h

# Admin Credentials (used only during seeding — change after first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@portal.local
ADMIN_PASSWORD=Admin@Portal2024!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Gateway Interoperability (Setu)
GATEWAY_API_KEY=your_gateway_api_key_here

# Validation — Configurable Formats
LICENCE_NUMBER_PATTERN=^[A-Z]{2}[0-9]{2}[0-9]{4}[0-9]{7}$
JAN_AADHAAR_ID_LENGTH=10

# Verification provider: mock | authorized
VERIFICATION_PROVIDER=mock

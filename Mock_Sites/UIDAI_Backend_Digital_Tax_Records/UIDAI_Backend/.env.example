# ==============================================================================
# PAN Records Service — Environment Configuration Template
# Department: Digital Tax Records — Demo Department
# Note: For demo/educational purposes only with synthetic data
# ==============================================================================

# Authentication & Security
SECRET_KEY=demo-tax-records-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gateway Interoperability (SIH26129)
# Use a distinct secret key for production/demo deployment
GATEWAY_API_KEY=your-placeholder-gateway-api-key-here
GATEWAY_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Database
DATABASE_URL=sqlite:///./pan_records.db

# Demo seed (idempotent, runs at startup)
# When not "false", app/main.py seeds the synthetic demo PAN records
# (SYNPAN-000123 etc.) into pan_records if absent. This keeps the demo
# working on ephemeral/free-tier hosts (e.g. Render) where the SQLite
# file is wiped on restart. Safe to run every boot — it never duplicates
# or errors. Set to "false" to manage demo data by hand.
SEED_DEMO_DATA=true

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aadhaar_portal_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Secret for Admin Sessions
JWT_SECRET=replace_with_a_secure_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=8h

# Initial Admin Setup (Development Seed)
# Used only by database/seedAdmin.js when initializing an admin account
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_admin_password_in_env

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5000

# Gateway Interoperability (Setu)
GATEWAY_ORIGINS=http://localhost:5173,http://localhost:3000
GATEWAY_API_KEY=your_gateway_api_key_here

# Department Branding
DEPARTMENT_NAME=National Identity Registry — Demo Department

